#!/bin/sh
# The gatekeeper allows only new or updated factory branches.
status=0
while read -r old_sha new_sha reference; do
    case "$reference" in
        refs/heads/factory/*)
            if [ "$new_sha" = "0000000000000000000000000000000000000000" ]; then
                echo "The gatekeeper refuses the delete of $reference" >&2
                status=1
            fi
            ;;
        *)
            echo "The gatekeeper refuses the push to $reference" >&2
            status=1
            ;;
    esac
done
exit "$status"
